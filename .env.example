# Copy to .env (in the project root, next to package.json) and fill in.
# .env is git-ignored — never commit real values.

# "production" makes the backend refuse to start without SECRET_KEY
ENVIRONMENT=development

# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Initial admin account (only used the first time, when it doesn't exist yet).
# If ADMIN_PASSWORD is empty, a random one is generated and printed once at startup.
ADMIN_EMAIL=admin@suhruth.edu
ADMIN_PASSWORD=

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reverse proxies in front of the backend that append to X-Forwarded-For
# (0 = direct connections, e.g. local dev; Render = 1). Used for login rate limiting.
TRUSTED_PROXY_HOPS=0

# Groq key for the AI assistant — server-side only. Do NOT prefix with VITE_.
GROQ_API_KEY=
# Optional: Groq model (default openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Where the frontend lives (used in certificate QR / verify links)
FRONTEND_URL=http://localhost:5173

# Payments: only "test" (simulated checkout) is implemented
PAYMENT_MODE=test

# Optional: defaults to a local SQLite file
# DATABASE_URL=postgresql://user:pass@host:5432/campussphere

# ── Frontend (only VITE_* variables are exposed to the browser) ──
# Leave empty locally (Vite proxies /api and /ws). In production (Vercel) set it to the backend URL:
# VITE_API_URL=https://campussphere-backend.onrender.com
