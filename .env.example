# Copy to .env (in the project root, next to package.json) and fill in.
# .env is git-ignored — never commit real values.

# "production" makes the backend refuse to start without SECRET_KEY
ENVIRONMENT=development

# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Initial admin account (only used the first time, when it doesn't exist yet).
# If ADMIN_PASSWORD is empty, a random one is generated and printed once at startup.
ADMIN_EMAIL=admin@suhruth.edu
ADMIN_PASSWORD=

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reverse proxies in front of the backend that append to X-Forwarded-For
# (0 = direct connections, e.g. local dev; Render = 1). Used for login rate limiting.
TRUSTED_PROXY_HOPS=0

# Groq key for the AI assistant — server-side only. Do NOT prefix with VITE_.
GROQ_API_KEY=
# Optional: Groq model (default openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: Sarvam AI key (sarvam.ai) — Mitra's Telugu / Hindi / English voice and speech input.
# Without it the browser's own voices are used (most devices have no Telugu voice). Server-side only.
SARVAM_API_KEY=
# SARVAM_SPEAKER=priya

# Where the frontend lives (used in certificate QR / verify links)
FRONTEND_URL=http://localhost:5173

# Forgot password: a 6-digit code by email. "console" (the default, development only) prints the code in the
# server log; "brevo" (300 emails/day free) or "resend" (100/day free) send it, using EMAIL_API_KEY and an
# EMAIL_FROM address you have verified with that service; "off" tells people to ask the Admin Office.
EMAIL_PROVIDER=console
# EMAIL_API_KEY=
# EMAIL_FROM=no-reply@your-domain.in
# EMAIL_FROM_NAME=CampusSphere · MVSR

# Small servers (e.g. Render free, 512 MB): set both to false. WARM_UTILIZATION_MODEL loads the analytics
# model (pandas + scikit-learn, ~110 MB) at startup; BACKGROUND_CRAWLS reads the college website on first
# boot and weekly (the memory peak). With it off, an admin refreshes them from the app.
# WARM_UTILIZATION_MODEL=true
# BACKGROUND_CRAWLS=true

# Where files are kept: "local" (default: private_uploads/ and media_uploads/ on this computer) or "s3", an
# S3-compatible bucket such as Backblaze B2 or Cloudflare R2 (needed on hosts that wipe their disk, e.g. Render
# free). The bucket stays private; the API streams files after its own permission checks. Copy existing files
# across with
#   python -m backend.app.core.storage_migrate --copy
# The S3_* values below can sit in .env without STORAGE_BACKEND=s3: the local backend keeps its local files and
# the copy script still finds the bucket.
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://s3.<region>.backblazeb2.com     # R2: https://<account id>.r2.cloudflarestorage.com
# S3_REGION=<region>                                       # e.g. us-east-005; R2: auto
# S3_BUCKET=campussphere-files
# S3_ACCESS_KEY_ID=                                        # B2: keyID
# S3_SECRET_ACCESS_KEY=                                    # B2: applicationKey

# Payments: only "test" (simulated checkout) is implemented
PAYMENT_MODE=test

# Optional: defaults to a local SQLite file
# DATABASE_URL=postgresql://user:pass@host:5432/campussphere

# ── Frontend (only VITE_* variables are exposed to the browser) ──
# Leave empty locally (Vite proxies /api and /ws). In production (Vercel) set it to the backend URL:
# VITE_API_URL=https://campussphere-backend.onrender.com
